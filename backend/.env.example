NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
JWT_SECRET=replace_with_a_unique_32_plus_character_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE_MS=604800000
# Create test keys in the Razorpay Dashboard while developing. Never expose the
# secret to the frontend or commit real credentials.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret
# Set this from the Razorpay webhook configuration for /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret
# RazorpayX payout API keys (optional outside payout-enabled deployments).
RAZORPAYX_KEY_ID=rzpx_replace_with_key_id
RAZORPAYX_KEY_SECRET=replace_with_your_razorpayx_secret
RAZORPAYX_ACCOUNT_NUMBER=replace_with_your_source_account_number
RAZORPAYX_PAYOUT_MODE=IMPS
RAZORPAYX_WEBHOOK_SECRET=replace_with_your_razorpayx_webhook_secret
# Generate a unique 32-byte key and encode it as 64 hexadecimal characters.
SELLER_PAYOUT_ENCRYPTION_KEY=replace_with_64_hex_characters
# Development uses a mock carrier. Production must use Delhivery and provide
# the account-specific endpoints, payload templates, and response mappings.
SHIPPING_PROVIDER=mock
DELHIVERY_API_TOKEN=replace_with_your_dedicated_delhivery_token
DELHIVERY_AUTH_HEADER=Authorization
DELHIVERY_AUTH_VALUE_PREFIX=Token
DELHIVERY_CREATE_SHIPMENT_METHOD=
DELHIVERY_CREATE_REVERSE_PICKUP_METHOD=
DELHIVERY_TRACKING_METHOD=
DELHIVERY_CANCEL_SHIPMENT_METHOD=
DELHIVERY_CANCEL_REVERSE_PICKUP_METHOD=
DELHIVERY_CREATE_SHIPMENT_URL=
DELHIVERY_CREATE_REVERSE_PICKUP_URL=
DELHIVERY_TRACKING_URL_TEMPLATE=
DELHIVERY_CANCEL_SHIPMENT_URL_TEMPLATE=
DELHIVERY_CANCEL_REVERSE_PICKUP_URL_TEMPLATE=
DELHIVERY_SHIPMENT_PAYLOAD_TEMPLATE=
DELHIVERY_REVERSE_PICKUP_PAYLOAD_TEMPLATE=
DELHIVERY_CANCEL_PAYLOAD_TEMPLATE=
DELHIVERY_SHIPMENT_ID_PATH=
DELHIVERY_TRACKING_NUMBER_PATH=
DELHIVERY_TRACKING_STATUS_PATH=
DELHIVERY_TRACKING_EVENTS_PATH=
DELHIVERY_EVENT_STATUS_PATH=
DELHIVERY_EVENT_TIME_PATH=
DELHIVERY_EVENT_LOCATION_PATH=
DELHIVERY_EVENT_DESCRIPTION_PATH=
# Use "none" for a separately hosted HTTPS frontend. Keep "lax" when the
# frontend and API are served from the same site.
COOKIE_SAME_SITE=lax
CLIENT_URL=http://localhost:3000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Set to 1 only when the app runs behind one trusted reverse proxy.
TRUST_PROXY=0
# Required when NODE_ENV=production and npm run seed is used
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=use_a_unique_long_password
